#!/usr/bin/env bash
# prompteval — workspace prompt-eval harness CLI (ADR-0039).
# Thin wrapper so `prompteval` works from any repo without PYTHONPATH games.
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROMPTEVAL_LIB_DIR="${SCRIPT_DIR}/lib" exec python3 -c '
import os
import sys
sys.path.insert(0, os.environ["PROMPTEVAL_LIB_DIR"])
from prompteval.cli import main
sys.exit(main())
' "$@"
